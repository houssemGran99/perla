# Where online orders are sent. Configure at least one channel in production;
# otherwise the checkout falls back to "send your order on Instagram / by phone".

# Telegram: create a bot with @BotFather, send it a message, then read your chat id
# from https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail via Resend (https://resend.com). ORDER_EMAIL_FROM must be on a verified domain.
# When set, customers who give an e-mail also receive a confirmation.
RESEND_API_KEY=
ORDER_EMAIL_FROM="PERLA <commandes@example.com>"
ORDER_EMAIL_TO=
