# Where online orders are sent. Configure at least one channel in production;
# otherwise the checkout falls back to "send your order on Instagram / by phone".

# --- E-mail (Resend, https://resend.com) ---
# Every new order is e-mailed to houssemgran1990@gmail.com (set in lib/data.ts).
# Quick start: create a free Resend account WITH houssemgran1990@gmail.com, create an API key,
# and set only RESEND_API_KEY. Orders are then sent from Resend's test sender
# (onboarding@resend.dev), which can only deliver to the account owner's own inbox.
RESEND_API_KEY=

# Optional: send to a different inbox instead.
ORDER_EMAIL_TO=

# Optional: a sender on your own domain, verified in Resend (e.g. "PERLA <commandes@perla.tn>").
# Required to e-mail anyone else — and enables confirmation e-mails to customers who give an address.
ORDER_EMAIL_FROM=

# --- Telegram (optional, instant notification on your phone) ---
# Create a bot with @BotFather, send it a message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
